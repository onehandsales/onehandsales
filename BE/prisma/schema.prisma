generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// 기능 : Workspace가 개인/개인사업자용인지 조직/회사용인지 구분합니다.
enum WorkspaceKind {
  /// 기능 : B2C 개인 또는 개인사업자 Workspace입니다.
  PERSONAL
  /// 기능 : B2B 회사 또는 조직 Workspace입니다.
  ORGANIZATION
}

/// 기능 : Workspace 전체 범위에서 멤버가 가지는 역할입니다.
enum WorkspaceMemberRole {
  /// 기능 : Workspace 소유자입니다.
  OWNER
  /// 기능 : Workspace 관리 권한을 가진 관리자입니다.
  ADMIN
  /// 기능 : Workspace 일반 멤버입니다.
  MEMBER
}

/// 기능 : Team이 Workspace 안에서 어떤 목적으로 쓰이는지 구분합니다.
enum TeamType {
  /// 기능 : B2C 또는 초기 Workspace에서 자동 생성되는 기본 Team입니다.
  DEFAULT
  /// 기능 : B2B 조직의 부서나 업무 조직 단위 Team입니다.
  DEPARTMENT
  /// 기능 : 특정 프로젝트나 임시 협업 단위 Team입니다.
  PROJECT
}

/// 기능 : Team 안에서 WorkspaceMember가 가지는 역할입니다.
enum TeamMemberRole {
  /// 기능 : Team을 이끄는 팀장 또는 관리자 역할입니다.
  MANAGER
  /// 기능 : Team에 참여하는 일반 멤버 역할입니다.
  MEMBER
}

/// 기능 : Workspace 안에서 데이터 생성/수정 주체가 어떤 종류인지 구분합니다.
enum ActorType {
  WORKSPACE_MEMBER
  SYSTEM
  API_TOKEN
  AUTOMATION
}

/// 기능 : AttributeDefinition이 어떤 형태의 값을 받을지 구분합니다.
enum AttributeType {
  /// 기능 : 생성자나 수정자처럼 행위자를 참조하는 값입니다.
  ActorReference
  /// 기능 : true/false 값을 저장합니다.
  Checkbox
  /// 기능 : 금액과 통화 정보를 저장합니다.
  Currency
  /// 기능 : 시간대 없는 날짜를 저장합니다.
  Date
  /// 기능 : 인터넷 도메인을 저장하고 회사/웹사이트 식별에 사용합니다.
  Domain
  /// 기능 : 이메일 주소를 저장합니다.
  EmailAddress
  /// 기능 : 이메일, 캘린더 이벤트 같은 커뮤니케이션 상호작용을 표현합니다.
  Interaction
  /// 기능 : 주소, 도시, 지역, 우편번호, 국가 같은 위치 정보를 저장합니다.
  Location
  /// 기능 : 사람 이름을 구조화해 저장합니다.
  PersonalName
  /// 기능 : 수량, 점수, 비율 같은 숫자 값을 저장합니다.
  Number
  /// 기능 : 국제 전화번호를 저장합니다.
  PhoneNumber
  /// 기능 : 별점이나 점수 평가를 저장합니다.
  Rating
  /// 기능 : 다른 Record를 값으로 참조합니다.
  RecordReference
  /// 기능 : 미리 정한 선택지 중 하나 또는 여러 개를 고릅니다.
  Select
  /// 기능 : 미리 정한 상태값 중 하나를 고르며 Kanban 단계와 프로세스 상태에 사용합니다.
  Status
  /// 기능 : 자유 텍스트를 저장합니다.
  Text
  /// 기능 : UTC 기준 날짜와 시간을 함께 저장합니다.
  Timestamp
}

enum OAuthProvider {
  /// 기능 : 기존 Kakao OAuth 계정 값을 보존하되 신규 런타임 로그인에서는 사용하지 않습니다.
  KAKAO
  /// 기능 : Google OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  GOOGLE
  /// 기능 : Apple OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  APPLE
  /// 기능 : LINE OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  LINE
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthDeviceStatus {
  ACTIVE
  REPLACED
  REVOKED
}

enum AuthDeviceSlot {
  MOBILE
  PERSONAL_LAPTOP
  WORK_LAPTOP
}

/// 기능 : 사용자 에러 신고 처리 상태를 구분합니다.
enum ErrorReportStatus {
  OPEN
}

/// 기능 : 사용자 지원 요청 문의 유형을 구분합니다.
enum SupportRequestType {
  FEATURE_QUESTION
  PRICING_QUESTION
  PHONE_CONSULTATION
  FEATURE_SUGGESTION
  OTHER
}

/// 기능 : 사용자 지원 요청 처리 상태를 구분합니다.
enum SupportRequestStatus {
  OPEN
}

/// 기능 : 로그인 전 공개 문의 접수 처리 상태를 구분합니다.
enum PublicContactRequestStatus {
  OPEN
}

model User {
  id                             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                          String?
  displayName                    String?
  platformRole                   PlatformRole @default(USER)
  status                         UserStatus   @default(ACTIVE)
  timeZone                       String       @default("Asia/Seoul")
  preferredLocale                String       @default("ko-KR")
  /// 기능 : 사용자의 기본 국가 코드이며 글로벌 입력값 기본값에 사용합니다.
  countryCode                    String       @default("KR")
  /// 기능 : 사용자의 기본 통화 코드이며 금액 입력 기본값에 사용합니다.
  defaultCurrencyCode            String       @default("KRW")
  signupLocale                   String?
  signupCountryCode              String?
  signupTimeZone                 String?
  lastLoginLocale                String?
  lastLoginCountryCode           String?
  lastLoginTimeZone              String?
  lastLoginAt                    DateTime?    @db.Timestamptz(3)
  jobSelectOnboardingCompletedAt DateTime?    @db.Timestamptz(3)
  createdAt                      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt                      DateTime?    @db.Timestamptz(3)

  oauthAccounts    UserOAuthAccount[]
  authDevices      AuthDevice[]
  authSessions     AuthSession[]
  workspaceMembers WorkspaceMember[]
  /// 기능 : 사용자가 등록한 회사 목록이다.
  /// 기능 : 사용자가 만든 회사 분야 옵션 목록이다.
  /// 기능 : 사용자가 만든 회사 지역 옵션 목록이다.
  /// 기능 : 사용자가 접수한 에러 신고 목록입니다.
  errorReports     ErrorReport[]
  /// 기능 : 사용자가 접수한 지원 요청 목록입니다.
  supportRequests  SupportRequest[]

  @@index([platformRole])
  @@index([status])
  @@index([createdAt])
}

/// 기능 : B2C 개인/개인사업자 또는 B2B 조직이 사용하는 최상위 작업 공간입니다.
model Workspace {
  /// 기능 : Workspace row의 고유 식별자입니다.
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 기능 : 사용자에게 보이는 Workspace 이름입니다.
  name               String
  /// 기능 : PERSONAL 또는 ORGANIZATION으로 Workspace 성격을 구분합니다.
  kind               WorkspaceKind
  /// 기능 : B2B 조직 Workspace일 때 회사/조직 이름을 저장합니다.
  organizationName   String?
  /// 기능 : B2B 조직 Workspace일 때 회사 도메인을 저장합니다.
  organizationDomain String?
  /// 기능 : Workspace 생성 시각입니다. UTC instant로 저장합니다.
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  /// 기능 : Workspace row의 마지막 수정 시각입니다. UTC instant로 저장합니다.
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  /// 기능 : 이 Workspace에 속한 멤버십 목록입니다.
  members                         WorkspaceMember[]
  /// 기능 : 이 Workspace 안에서 생성된 Team 목록입니다.
  teams                           Team[]
  /// 기능 : 이 Workspace 안에서 생성된 TeamMember 연결 목록입니다.
  teamMembers                     TeamMember[]
  /// 기능 : 이 Workspace 안에서 생성된 Actor 목록입니다.
  actors                          Actor[]
  /// 기능 : 이 Workspace 안에서 정의된 Object 목록입니다.
  objectDefinitions               ObjectDefinition[]
  /// 기능 : 이 Workspace 안에서 정의된 Attribute 목록입니다.
  attributeDefinitions            AttributeDefinition[]
  /// 기능 : 이 Workspace 안에서 생성된 RecordDefinition 목록입니다.
  recordDefinitions               RecordDefinition[]
  /// 기능 : 이 Workspace 안에서 생성된 RecordAttributeValueDefinition 목록입니다.
  recordAttributeValueDefinitions RecordAttributeValueDefinition[]
  /// 기능 : 이 Workspace 안에서 정의된 SelectOptionDefinition 목록입니다.
  selectOptionDefinitions         SelectOptionDefinition[]
  /// 기능 : 이 Workspace 안에서 정의된 StatusOptionDefinition 목록입니다.
  statusOptionDefinitions         StatusOptionDefinition[]
  /// 기능 : 이 Workspace 안에서 정의된 RelationshipDefinition 목록입니다.
  relationshipDefinitions         RelationshipDefinition[]

  @@index([kind])
}

/// 기능 : User가 특정 Workspace에 참여한 멤버십과 워크스페이스 단위 역할을 저장합니다.
model WorkspaceMember {
  /// 기능 : WorkspaceMember row의 고유 식별자입니다.
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 기능 : 참여한 Workspace ID입니다.
  workspaceId String              @db.Uuid
  /// 기능 : 참여한 User ID입니다.
  userId      String              @db.Uuid
  /// 기능 : Workspace 전체 범위에서의 역할입니다.
  role        WorkspaceMemberRole @default(MEMBER)
  /// 기능 : User가 Workspace에 참여한 시각입니다. UTC instant로 저장합니다.
  joinedAt    DateTime            @default(now()) @db.Timestamptz(3)
  /// 기능 : WorkspaceMember 생성 시각입니다. UTC instant로 저장합니다.
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  /// 기능 : WorkspaceMember row의 마지막 수정 시각입니다. UTC instant로 저장합니다.
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  /// 기능 : 이 멤버십이 속한 Workspace입니다.
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// 기능 : 이 멤버십과 연결된 User입니다.
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// 기능 : 이 WorkspaceMember가 참여한 TeamMember 연결 목록입니다.
  teamMembers TeamMember[]
  /// 기능 : 이 WorkspaceMember에 연결된 Actor 목록입니다.
  actors      Actor[]

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

/// 기능 : Workspace 안에서 멤버를 부서, 프로젝트, 기본 업무공간 단위로 묶는 그룹입니다.
model Team {
  /// 기능 : Team row의 고유 식별자입니다.
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 기능 : Team이 속한 Workspace ID입니다.
  workspaceId String   @db.Uuid
  /// 기능 : 사용자에게 보이는 Team 이름입니다.
  name        String
  /// 기능 : Team의 목적이나 범위를 설명하는 선택 입력값입니다.
  description String?
  /// 기능 : DEFAULT, DEPARTMENT, PROJECT로 Team 사용 목적을 구분합니다.
  teamType    TeamType @default(DEPARTMENT)
  /// 기능 : Workspace의 기본 Team 여부입니다. 한 Workspace에 하나만 둘 수 있습니다.
  isDefault   Boolean  @default(false)
  /// 기능 : Team 생성 시각입니다. UTC instant로 저장합니다.
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  /// 기능 : Team row의 마지막 수정 시각입니다. UTC instant로 저장합니다.
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  /// 기능 : 이 Team이 속한 Workspace입니다.
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// 기능 : 이 Team에 참여한 TeamMember 연결 목록입니다.
  teamMembers TeamMember[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId])
}

/// 기능 : WorkspaceMember와 Team의 다대다 연결과 팀 안에서의 역할을 저장합니다.
model TeamMember {
  /// 기능 : TeamMember row의 고유 식별자입니다.
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 기능 : TeamMember 연결이 속한 Workspace ID입니다.
  workspaceId       String         @db.Uuid
  /// 기능 : 참여한 Team ID입니다.
  teamId            String         @db.Uuid
  /// 기능 : Team에 참여한 WorkspaceMember ID입니다.
  workspaceMemberId String         @db.Uuid
  /// 기능 : Team 안에서의 역할입니다.
  role              TeamMemberRole @default(MEMBER)
  /// 기능 : WorkspaceMember가 Team에 참여한 시각입니다. UTC instant로 저장합니다.
  joinedAt          DateTime       @default(now()) @db.Timestamptz(3)
  /// 기능 : TeamMember 생성 시각입니다. UTC instant로 저장합니다.
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  /// 기능 : TeamMember row의 마지막 수정 시각입니다. UTC instant로 저장합니다.
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  /// 기능 : 이 TeamMember 연결이 속한 Workspace입니다.
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// 기능 : 같은 Workspace 안에서 연결된 Team입니다.
  team            Team            @relation(fields: [teamId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Cascade)
  /// 기능 : 같은 Workspace 안에서 Team에 참여한 WorkspaceMember입니다.
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([teamId, workspaceMemberId])
  @@index([workspaceId])
  @@index([teamId])
  @@index([workspaceMemberId])
}

/// 기능 : Workspace 안에서 데이터 생성/수정 주체를 저장합니다.
model Actor {
  /// 기능 : Actor row의 고유 식별자입니다.
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 기능 : Actor가 속한 Workspace ID입니다.
  workspaceId         String    @db.Uuid
  /// 기능 : Actor의 주체 종류입니다.
  type                ActorType
  /// 기능 : WORKSPACE_MEMBER Actor일 때 연결되는 WorkspaceMember ID입니다.
  workspaceMemberId   String    @db.Uuid
  /// 기능 : SYSTEM Actor일 때 시스템 주체를 식별하는 key입니다.
  systemKey           String?
  /// 기능 : 감사 표시용 이름 snapshot입니다.
  displayNameSnapshot String?
  /// 기능 : 감사 표시용 email snapshot입니다.
  emailSnapshot       String?
  /// 기능 : Actor 생성 시각입니다. UTC instant로 저장합니다.
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  /// 기능 : Actor row의 마지막 수정 시각입니다. UTC instant로 저장합니다.
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  /// 기능 : Actor가 속한 Workspace입니다.
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// 기능 : 같은 Workspace 안에서 Actor에 연결된 WorkspaceMember입니다.
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId, workspaceId], references: [id, workspaceId], onDelete: Cascade, onUpdate: Cascade)

  /// 기능 : 이 Actor가 생성한 ObjectDefinition 목록입니다.
  createdObjectDefinitions               ObjectDefinition[]               @relation("ObjectDefinitionCreatedByActor")
  /// 기능 : 이 Actor가 마지막으로 수정한 ObjectDefinition 목록입니다.
  updatedObjectDefinitions               ObjectDefinition[]               @relation("ObjectDefinitionUpdatedByActor")
  /// 기능 : 이 Actor가 생성한 AttributeDefinition 목록입니다.
  createdAttributeDefinitions            AttributeDefinition[]            @relation("AttributeDefinitionCreatedByActor")
  /// 기능 : 이 Actor가 마지막으로 수정한 AttributeDefinition 목록입니다.
  updatedAttributeDefinitions            AttributeDefinition[]            @relation("AttributeDefinitionUpdatedByActor")
  /// 기능 : 이 Actor가 생성한 RecordDefinition 목록입니다.
  createdRecordDefinitions               RecordDefinition[]               @relation("RecordDefinitionCreatedByActor")
  /// 기능 : 이 Actor가 마지막으로 수정한 RecordDefinition 목록입니다.
  updatedRecordDefinitions               RecordDefinition[]               @relation("RecordDefinitionUpdatedByActor")
  /// 기능 : 이 Actor가 생성한 RecordAttributeValueDefinition 목록입니다.
  createdRecordAttributeValueDefinitions RecordAttributeValueDefinition[] @relation("RecordAttributeValueDefinitionCreatedByActor")
  /// 기능 : 이 Actor가 마지막으로 수정한 RecordAttributeValueDefinition 목록입니다.
  updatedRecordAttributeValueDefinitions RecordAttributeValueDefinition[] @relation("RecordAttributeValueDefinitionUpdatedByActor")
  /// 기능 : 이 Actor를 대상으로 참조하는 RecordAttributeValueDefinition 목록입니다.
  targetRecordAttributeValueDefinitions  RecordAttributeValueDefinition[] @relation("RecordAttributeValueDefinitionTargetActor")
  /// 기능 : 이 Actor가 생성한 SelectOptionDefinition 목록입니다.
  createdSelectOptionDefinitions         SelectOptionDefinition[]         @relation("SelectOptionDefinitionCreatedByActor")
  /// 기능 : 이 Actor가 마지막으로 수정한 SelectOptionDefinition 목록입니다.
  updatedSelectOptionDefinitions         SelectOptionDefinition[]         @relation("SelectOptionDefinitionUpdatedByActor")
  /// 기능 : 이 Actor가 생성한 StatusOptionDefinition 목록입니다.
  createdStatusOptionDefinitions         StatusOptionDefinition[]         @relation("StatusOptionDefinitionCreatedByActor")
  /// 기능 : 이 Actor가 마지막으로 수정한 StatusOptionDefinition 목록입니다.
  updatedStatusOptionDefinitions         StatusOptionDefinition[]         @relation("StatusOptionDefinitionUpdatedByActor")
  /// 기능 : 이 Actor가 생성한 RelationshipDefinition 목록입니다.
  createdRelationshipDefinitions         RelationshipDefinition[]         @relation("RelationshipDefinitionCreatedByActor")
  /// 기능 : 이 Actor가 마지막으로 수정한 RelationshipDefinition 목록입니다.
  updatedRelationshipDefinitions         RelationshipDefinition[]         @relation("RelationshipDefinitionUpdatedByActor")
}

/// 기능 : Workspace 안에서 회사, 고객, 매물 같은 관리 대상 타입을 정의합니다.
model ObjectDefinition {
  /// 기능 : ObjectDefinition row의 고유 식별자입니다.
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 기능 : ObjectDefinition이 속한 Workspace ID입니다.
  workspaceId      String   @db.Uuid
  /// 기능 : ObjectDefinition을 생성한 Actor ID입니다.
  createdByActorId String   @db.Uuid
  /// 기능 : ObjectDefinition을 마지막으로 수정한 Actor ID입니다.
  updatedByActorId String?  @db.Uuid
  /// 기능 : 코드에서 사용하는 Object 고유 이름입니다.
  apiSlug          String
  /// 기능 : 사용자에게 보여줄 단수 표시 이름입니다.
  singularName     String
  /// 기능 : 목록 또는 복수 문맥에서 보여줄 표시 이름입니다.
  pluralName       String
  /// 기능 : 화면 표시용 아이콘입니다.
  icon             String?
  /// 기능 : ObjectDefinition 설명입니다.
  description      String?
  /// 기능 : ObjectDefinition 생성 시각입니다. UTC instant로 저장합니다.
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
