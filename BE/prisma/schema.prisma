generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OAuthProvider {
  /// 기능 : 기존 Kakao OAuth 계정 값을 보존하되 신규 런타임 로그인에서는 사용하지 않습니다.
  KAKAO
  /// 기능 : Google OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  GOOGLE
  /// 기능 : Apple OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  APPLE
  /// 기능 : LINE OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  LINE
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthDeviceStatus {
  ACTIVE
  REPLACED
  REVOKED
}

enum AuthDeviceSlot {
  MOBILE
  PERSONAL_LAPTOP
  WORK_LAPTOP
}

enum MeetingNoteSourceType {
  MANUAL
  TEXT_AI
  STT_AI
}

enum BusinessCardScanStatus {
  OCR_SUCCESS
  OCR_FAILED
  CONFIRMED
}

enum BusinessCardResolution {
  EXISTING
  CREATED
}

enum ImportTemplateType {
  COMPANY
  CONTACT
  PRODUCT
  DEAL
}

enum ImportJobStatus {
  UPLOADED
  MAPPED
  NEEDS_REVIEW
  READY_TO_CONFIRM
  CONFIRMING
  CONFIRMED
  FAILED
  CANCELED
  EXPIRED
}

enum ImportJobRowStatus {
  PENDING
  VALID
  INVALID
  EXCLUDED
  IMPORTED
  FAILED
}

enum ImportJobMappingSource {
  NONE
  AI
  RULE_BASED
  USER
}

enum ImportUploadedFileStatus {
  STORED
  PARSED
  DELETED
  EXPIRED
}

enum ImportJobErrorType {
  PARSE
  AI_MAPPING
  VALIDATION
  CONFIRM
  STORAGE
  SYSTEM
}

enum ImportJobErrorSeverity {
  INFO
  WARNING
  ERROR
}

enum NotificationType {
  SCHEDULE_START_REMINDER
  DEAL_DUE_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

enum NotificationSourceType {
  SCHEDULE
  DEAL
}

enum NotificationDeliveryChannel {
  EMAIL
  BROWSER_PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

enum BrowserPushSubscriptionStatus {
  ACTIVE
  REVOKED
}

enum ExternalCalendarProvider {
  GOOGLE
}

enum ExternalCalendarConnectionStatus {
  CONNECTED
  RECONNECT_REQUIRED
  DISCONNECTED
}

enum ExternalCalendarSourceStatus {
  SELECTED
  UNSELECTED
}

enum ScheduleSourceType {
  INTERNAL
  GOOGLE
}

enum ScheduleExternalSyncStatus {
  SYNCED
  LOCAL_MODIFIED
  GOOGLE_DELETED
  LOCAL_DELETED
}

enum AiWeeklySalesReportStatus {
  GENERATING
  READY
  FAILED
}

enum AiWeeklySalesReportSuggestionType {
  RISK
  NEXT_ACTION
  FOLLOW_UP
  DATA_CLEANUP
}

enum AiSuggestionPriority {
  LOW
  MEDIUM
  HIGH
}

enum AiJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum AiProviderOperation {
  WEEKLY_SALES_REPORT
  FOLLOW_UP_EMAIL_DRAFT
  FOLLOW_UP_SMS_DRAFT
  /// 기능 : 회의 원문 텍스트를 회의록 초안으로 변환하는 provider 호출입니다.
  MEETING_NOTE_TEXT_DRAFT
  /// 기능 : 회의 음성 파일을 transcript로 변환하는 STT provider 호출입니다.
  MEETING_NOTE_STT_TRANSCRIPTION
  /// 기능 : STT transcript를 회의록 초안으로 변환하는 provider 호출입니다.
  MEETING_NOTE_STT_DRAFT
  /// 기능 : 저장된 회의록에서 다음 행동 후보를 생성하는 provider 호출입니다.
  MEETING_NOTE_NEXT_ACTION_DRAFT
  /// 기능 : 저장된 회의록에서 follow-up 문안 초안을 생성하는 provider 호출입니다.
  MEETING_NOTE_FOLLOW_UP_DRAFT
}

enum AiProviderCallStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ExternalEmailProvider {
  GOOGLE
  MICROSOFT
}

enum ExternalEmailConnectionStatus {
  CONNECTED
  RECONNECT_REQUIRED
  DISCONNECTED
}

enum SmsSenderNumberStatus {
  PENDING_VERIFICATION
  VERIFIED
  REVOKED
}

enum FollowUpDeliveryChannel {
  EMAIL
  SMS
}

enum FollowUpMessageStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum FollowUpTargetType {
  AI_WEEKLY_REPORT
  DEAL
  CONTACT
  MEETING_NOTE
  SCHEDULE
}

enum FollowUpDeliveryAttemptStatus {
  PENDING
  SENT
  FAILED
  CANCELED
}

/// 기능 : 딜 활동 내역에 표시할 활동 종류를 정의한다.
enum DealActivityType {
  DEAL_CREATED
  STAGE_CHANGED
  NEXT_ACTION_CREATED
  NEXT_ACTION_COMPLETION_CHANGED
  SCHEDULE_LINKED
  SCHEDULE_UNLINKED
  MEETING_NOTE_LINKED
  MEETING_NOTE_UNLINKED
  FOLLOW_UP_SENT
  FOLLOW_UP_FAILED
  CALL
  MEETING
  EMAIL
  VISIT
  NOTE
}

/// 기능 : 딜 활동이 시스템, 사용자, 연결 도메인 중 어디에서 생성됐는지 정의한다.
enum DealActivitySourceType {
  SYSTEM
  USER
  NEXT_ACTION
  SCHEDULE
  MEETING_NOTE
  FOLLOW_UP
}

/// 기능 : 제품 분석 이벤트가 어떤 경로에서 기록됐는지 구분합니다.
enum ProductAnalyticsEventSource {
  CLIENT
  SERVER
  SYSTEM
}

/// 기능 : 사용자 activation snapshot 계산 상태를 구분합니다.
enum UserActivationStatus {
  NOT_ACTIVATED
  ACTIVATED
}

/// 기능 : 제품 분석 이벤트가 연결할 수 있는 안전한 대상 타입을 구분합니다.
enum ProductAnalyticsTargetType {
  USER
  DEAL
  SCHEDULE
  MEETING_NOTE
  BUSINESS_CARD_SCAN
  IMPORT_JOB
  EXPORT
}

/// 기능 : Admin 감사 로그에 기록할 운영 action을 구분합니다.
enum AdminAuditAction {
  ADMIN_LOGIN
  ADMIN_USER_LIST_VIEW
  ADMIN_USER_DETAIL_VIEW
  ADMIN_DOMAIN_RECORDS_VIEW
  ADMIN_TRASH_VIEW
  ADMIN_PROVIDER_FAILURE_VIEW
  ADMIN_ANALYTICS_VIEW
  ADMIN_ACCOUNT_DELETION_VIEW
  ADMIN_DATA_EXPORT_VIEW
  ADMIN_SYSTEM_CHECK_VIEW
  ADMIN_SYSTEM_CHECK_RECORDED
  ADMIN_SENSITIVE_RAW_ACCESS
}

/// 기능 : Admin 감사 로그 처리 결과를 구분합니다.
enum AdminAuditResult {
  SUCCESS
  DENIED
  FAILED
}

/// 기능 : Admin 감사 또는 민감 원문 조회 대상 종류를 구분합니다.
enum AdminTargetType {
  USER
  COMPANY
  CONTACT
  PRODUCT
  DEAL
  SCHEDULE
  MEETING_NOTE
  BUSINESS_CARD_SCAN
  IMPORT_JOB
  NOTIFICATION
  PROVIDER_FAILURE
  TRASH_RECORD
  ACCOUNT_DELETION_REQUEST
  DATA_EXPORT_REQUEST
  SYSTEM_OPERATION_CHECK
}

/// 기능 : Admin 민감 원문 조회에서 허용하는 필드 묶음을 구분합니다.
enum AdminSensitiveFieldSet {
  USER_CONTACT
  DOMAIN_MEMO
  MEETING_NOTE_BODY
  TRASH_RECORD_DETAIL
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String?
  displayName          String?
  role                 UserRole   @default(USER)
  status               UserStatus @default(ACTIVE)
  timeZone             String     @default("Asia/Seoul")
  preferredLocale      String     @default("ko-KR")
  /// 기능 : 사용자의 기본 국가 코드이며 글로벌 입력값 기본값에 사용합니다.
  countryCode          String     @default("KR")
  /// 기능 : 사용자의 기본 통화 코드이며 금액 입력 기본값에 사용합니다.
  defaultCurrencyCode  String     @default("KRW")
  signupLocale         String?
  signupCountryCode    String?
  signupTimeZone       String?
  lastLoginLocale      String?
  lastLoginCountryCode String?
  lastLoginTimeZone    String?
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  oauthAccounts               UserOAuthAccount[]
  authDevices                 AuthDevice[]
  authSessions                AuthSession[]
  /// 기능 : 사용자가 등록한 회사 목록이다.
  companies                   Company[]
  /// 기능 : 사용자가 만든 회사 분야 옵션 목록이다.
  companyFields               CompanyField[]
  /// 기능 : 사용자가 만든 회사 지역 옵션 목록이다.
  companyRegions              CompanyRegion[]
  /// 기능 : 사용자가 작성한 회사 일반 메모 로그 목록이다.
  companyMemoLogs             CompanyMemoLog[]
  /// 기능 : 사용자가 작성한 회사 개인 비밀 메모 로그 목록이다.
  companyPrivateMemoLogs      CompanyUserPrivateMemoLog[]
  /// 기능 : 사용자가 등록한 담당자 목록이다.
  contacts                    Contact[]
  /// 기능 : 사용자가 만든 담당자 직급 옵션 목록이다.
  contactJobGrades            ContactJobGrade[]
  /// 기능 : 사용자가 만든 담당자 부서 옵션 목록이다.
  contactDepartments          ContactDepartment[]
  /// 기능 : 사용자가 작성한 담당자 일반 메모 로그 목록이다.
  contactMemoLogs             ContactMemoLog[]
  /// 기능 : 사용자가 작성한 담당자 개인 비밀 메모 로그 목록이다.
  contactPrivateMemoLogs      ContactUserPrivateMemoLog[]
  /// 기능 : 사용자가 등록한 제품 목록이다.
  products                    Product[]
  /// 기능 : 사용자가 만든 제품 카테고리 옵션 목록이다.
  productCategories           ProductCategory[]
  /// 기능 : 사용자가 만든 제품 상태 옵션 목록이다.
  productStatuses             ProductStatus[]
  /// 기능 : 사용자가 작성한 제품 일반 메모 로그 목록이다.
  productMemoLogs             ProductMemoLog[]
  /// 기능 : 사용자가 작성한 제품 개인 비밀 메모 로그 목록이다.
  productPrivateMemoLogs      ProductUserPrivateMemoLog[]
  /// 기능 : 사용자가 등록한 딜 목록이다.
  deals                       Deal[]
  /// 기능 : 사용자가 딜에 연결한 회사 매핑 목록이다.
  dealCompanies               DealCompany[]
  /// 기능 : 사용자가 딜에 연결한 담당자 매핑 목록이다.
  dealContacts                DealContact[]
  /// 기능 : 사용자가 작성한 딜 다음 행동 로그 목록이다.
  dealFollowingActionLogs     DealFollowingActionLog[]
  /// 기능 : 사용자가 작성한 딜 메모 로그 목록이다.
  dealMemoLogs                DealMemoLog[]
  /// 기능 : 사용자가 만든 딜 활동 목록이다. 모든 조회와 변경은 이 userId로 제한한다.
  dealActivities              DealActivity[]
  /// 기능 : 사용자가 딜에 연결한 제품 매핑 목록이다.
  dealProducts                DealProduct[]
  /// 기능 : 사용자가 등록한 일정 목록이다.
  schedules                   Schedule[]
  externalCalendarConnections ExternalCalendarConnection[]
  externalCalendarSources     ExternalCalendarSource[]
  /// 기능 : 사용자가 일정에 연결한 딜 매핑 목록이다.
  scheduleDeals               ScheduleDeal[]
  meetingNotes                MeetingNote[]
  meetingNoteCompanies        MeetingNoteCompany[]
  meetingNoteContacts         MeetingNoteContact[]
  meetingNoteProducts         MeetingNoteProduct[]
  meetingNoteDeals            MeetingNoteDeal[]
  businessCardScanLogs        BusinessCardScanLog[]
  importUserLogs              ImportUserLog[]
  importJobs                  ImportJob[]
  importJobRows               ImportJobRow[]
  importJobErrors             ImportJobError[]
  importUploadedFiles         ImportUploadedFile[]
  /// 기능 : 사용자의 알림 수신 설정 row입니다. 사용자당 하나만 허용합니다.
  notificationSetting         UserNotificationSetting?
  /// 기능 : 사용자에게 예약되거나 발송된 앱 안 알림 목록입니다.
  notifications               Notification[]
  /// 기능 : 사용자에게 시도된 email/browser push 발송 이력 목록입니다.
  notificationDeliveries      NotificationDeliveryAttempt[]
  /// 기능 : 사용자의 browser push 구독 정보를 암호화해 저장한 목록입니다.
  browserPushSubscriptions    BrowserPushSubscription[]
  /// 기능 : 사용자의 주간 AI 영업 리포트 version 목록입니다.
  aiWeeklySalesReports        AiWeeklySalesReport[]
  /// 기능 : 사용자의 주간 AI 리포트 제안 목록입니다.
  aiWeeklyReportSuggestions   AiWeeklySalesReportSuggestion[]
  /// 기능 : 사용자의 AI 비동기 작업 목록입니다.
  aiJobs                      AiJob[]
  /// 기능 : 사용자의 AI provider 호출 이력 목록입니다.
  aiProviderCallLogs          AiProviderCallLog[]
  /// 기능 : 사용자의 제품 분석 원본 이벤트 목록입니다. 계정 실제 삭제 시 함께 삭제됩니다.
  productAnalyticsEvents      ProductAnalyticsEvent[]
  /// 기능 : 사용자의 activation 계산 snapshot입니다. 계정 실제 삭제 시 함께 삭제됩니다.
  activationSnapshot          UserActivationSnapshot?
  /// Feature: external email account connections used for follow-up delivery.
  externalEmailConnections    ExternalEmailConnection[]
  /// Feature: short-lived OAuth state rows for follow-up email connections.
  externalEmailOAuthStates    ExternalEmailOAuthState[]
  /// Feature: verified sender phone numbers used for follow-up SMS delivery.
  smsSenderNumbers            SmsSenderNumber[]
  /// Feature: channel consent acknowledgements for user-initiated follow-up delivery.
  followUpConsentNotices      FollowUpConsentNotice[]
  /// Feature: AI/user follow-up draft and delivery history.
  followUpMessages            FollowUpMessage[]
  /// Feature: follow-up message target links for timeline/history.
  followUpMessageTargets      FollowUpMessageTarget[]
  /// Feature: provider send attempt logs for follow-up messages.
  followUpDeliveryAttempts    FollowUpDeliveryAttempt[]
  /// 기능 : 이 사용자가 수행한 Admin 감사 로그 목록입니다.
  adminAuditLogs              AdminAuditLog[]             @relation("AdminAuditActor")
  /// 기능 : 이 사용자가 수행한 Admin 민감 원문 조회 로그 목록입니다.
  adminSensitiveAccessLogs    AdminSensitiveAccessLog[]   @relation("AdminSensitiveAccessActor")

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model UserOAuthAccount {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  provider         OAuthProvider
  providerUserId   String
  providerEmail    String?
  accessTokenHash  String?
  refreshTokenHash String?
  tokenExpiresAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
}

model AuthDevice {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  deviceSlot   AuthDeviceSlot
  deviceIdHash String
  label        String?
  status       AuthDeviceStatus @default(ACTIVE)
  lastSeenAt   DateTime?
  replacedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user                   User                    @relation(fields: [userId], references: [id])
  sessions               AuthSession[]
  /// 기능 : 이 인증 기기에서 발생한 제품 분석 이벤트 목록입니다.
  productAnalyticsEvents ProductAnalyticsEvent[]

  @@index([userId])
  @@index([userId, deviceSlot, status])
  @@index([userId, deviceIdHash])
}

model AuthSession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  authDeviceId     String            @db.Uuid
  status           AuthSessionStatus @default(ACTIVE)
  refreshTokenHash String?
  userAgent        String?
  ipAddressHash    String?
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user                   User                    @relation(fields: [userId], references: [id])
  authDevice             AuthDevice              @relation(fields: [authDeviceId], references: [id])
  /// 기능 : 이 app session에서 발생한 제품 분석 이벤트 목록입니다.
  productAnalyticsEvents ProductAnalyticsEvent[]

  @@index([userId])
  @@index([authDeviceId])
  @@index([status])
  @@index([expiresAt])
}

/// 기능 : Admin 주요 조회와 운영 action을 append-only로 남기는 감사 로그입니다.
model AdminAuditLog {
  /// 기능 : Admin 감사 로그 row의 고유 식별자입니다.
  id                 String                    @id @default(uuid()) @db.Uuid
  /// 기능 : 작업을 수행한 관리자 사용자 ID입니다.
  adminUserId        String                    @db.Uuid
  /// 기능 : 감사 대상 사용자 ID snapshot입니다. 계정 삭제를 막지 않도록 FK를 만들지 않습니다.
  targetUserId       String?                   @db.Uuid
  /// 기능 : 감사 대상 종류입니다.
  targetType         AdminTargetType
  /// 기능 : 감사 대상 record ID입니다.
  targetId           String?                   @db.Uuid
  /// 기능 : 수행된 Admin action입니다.
  action             AdminAuditAction
  /// 기능 : 수행 결과입니다.
  result             AdminAuditResult          @default(SUCCESS)
  /// 기능 : 운영자가 입력한 사유입니다. 원문 민감값은 저장하지 않습니다.
  reason             String?                   @db.Text
  /// 기능 : HTTP 요청 추적 ID입니다.
  requestId          String?
  /// 기능 : IP 원문 대신 저장하는 HMAC 또는 단방향 hash입니다.
  ipHash             String?
  /// 기능 : User-Agent 원문 대신 저장하는 hash입니다.
  userAgentHash      String?
  /// 기능 : 원문 민감값 없는 구조화 metadata입니다.
  metadataJson       Json                      @default("{}")
  /// 기능 : 감사 로그 생성 시각입니다.
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)

  /// 기능 : 작업을 수행한 관리자 사용자입니다.
  adminUser          User                      @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: Restrict)
  /// 기능 : 이 감사 로그와 1:1로 연결된 민감 원문 조회 로그입니다.
  sensitiveAccessLog AdminSensitiveAccessLog?

  @@index([adminUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

/// 기능 : Admin 민감 원문 조회 사유와 반환 필드명을 추적하는 append-only 로그입니다.
model AdminSensitiveAccessLog {
  /// 기능 : 민감 원문 조회 로그 row의 고유 식별자입니다.
  id                 String                 @id @default(uuid()) @db.Uuid
  /// 기능 : 연결된 AdminAuditLog ID입니다.
  auditLogId         String                 @unique @db.Uuid
  /// 기능 : 작업을 수행한 관리자 사용자 ID입니다.
  adminUserId        String                 @db.Uuid
  /// 기능 : 민감정보 소유 사용자 ID snapshot입니다.
  targetUserId       String                 @db.Uuid
  /// 기능 : 민감정보 대상 종류입니다.
  targetType         AdminTargetType
  /// 기능 : 민감정보 대상 record ID입니다.
  targetId           String                 @db.Uuid
  /// 기능 : 조회한 민감 필드 묶음입니다.
  fieldSet           AdminSensitiveFieldSet
  /// 기능 : 운영자가 입력한 원문 조회 사유입니다.
  reason             String                 @db.Text
  /// 기능 : 원문 값 없이 반환된 필드명만 저장합니다.
  returnedFieldNames String[]
  /// 기능 : 민감 원문 조회 로그 생성 시각입니다.
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)

  /// 기능 : 원문 조회와 같은 transaction에서 생성한 감사 로그입니다.
  auditLog           AdminAuditLog          @relation(fields: [auditLogId], references: [id], onDelete: Restrict)
  /// 기능 : 작업을 수행한 관리자 사용자입니다.
  adminUser          User                   @relation("AdminSensitiveAccessActor", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

/// 기능 : Global B2C 제품 사용 분석을 위한 allowlist 기반 원본 이벤트입니다.
model ProductAnalyticsEvent {
  /// 기능 : 분석 이벤트 row의 고유 식별자입니다.
  id             String                      @id @default(uuid()) @db.Uuid
  /// 기능 : 이벤트를 발생시킨 사용자입니다. 계정 실제 삭제 시 함께 삭제됩니다.
  userId         String                      @db.Uuid
  /// 기능 : Backend app session 식별자입니다. Client가 보내지 않고 Backend가 현재 인증에서 채웁니다.
  authSessionId  String?                     @db.Uuid
  /// 기능 : 인증 device 식별자입니다. AuthSession 조회로 Backend가 채웁니다.
  authDeviceId   String?                     @db.Uuid
  /// 기능 : allowlist에 등록된 snake_case 이벤트 이름입니다.
  eventName      String
  /// 기능 : 이벤트 payload schema 버전입니다.
  eventVersion   Int                         @default(1)
  /// 기능 : client, server, system 중 이벤트 기록 출처입니다.
  source         ProductAnalyticsEventSource
  /// 기능 : 이벤트 발생 시각입니다. UTC instant로 저장합니다.
  occurredAt     DateTime                    @db.Timestamptz(3)
  /// 기능 : 이벤트 당시 사용자 timezone 기준 날짜입니다. D1/D7/D30 계산에 사용합니다.
  eventDate      DateTime                    @db.Date
  /// 기능 : 이벤트 당시 사용자 IANA timezone입니다.
  timeZone       String
  /// 기능 : 같은 server event의 중복 기록을 막는 선택 idempotency key입니다.
  idempotencyKey String?
  /// 기능 : 이벤트가 연결된 안전한 대상 타입입니다. 회사명/담당자명 같은 PII는 저장하지 않습니다.
  targetType     ProductAnalyticsTargetType?
  /// 기능 : 이벤트가 연결된 안전한 대상 UUID입니다. payload에는 중복 저장하지 않습니다.
  targetId       String?                     @db.Uuid
  /// 기능 : event별 allowlist schema를 통과한 비식별 payload입니다.
  payloadJson    Json                        @default("{}")
  /// 기능 : 이벤트가 수집된 시각입니다.
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)

  /// 기능 : 이벤트를 발생시킨 사용자입니다.
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 기능 : 이벤트가 발생한 app session입니다.
  authSession AuthSession? @relation(fields: [authSessionId], references: [id], onDelete: SetNull)
  /// 기능 : 이벤트가 발생한 인증 기기입니다.
  authDevice  AuthDevice?  @relation(fields: [authDeviceId], references: [id], onDelete: SetNull)

  /// 기능 : server event idempotency key 중복 저장을 방지합니다.
  @@unique([userId, eventName, idempotencyKey])
  /// 기능 : 사용자별 핵심 event 발생 순서와 activation 계산 조회에 사용합니다.
  @@index([userId, eventName, occurredAt])
  /// 기능 : 사용자 timezone 기준 일자별 active 여부 계산에 사용합니다.
  @@index([userId, eventDate])
  /// 기능 : event 이름과 사용자 timezone 기준 날짜별 aggregate 계산에 사용합니다.
  @@index([eventName, eventDate])
  /// 기능 : client/server/system 출처별 수집 상태 확인에 사용합니다.
  @@index([source, createdAt])
  /// 기능 : 365일 raw event retention purge에 사용합니다.
  @@index([occurredAt])
  /// 기능 : 현재 app session에서 파생된 event 추적에 사용합니다.
  @@index([authSessionId])
  /// 기능 : 인증 device 단위 event 분석에 사용합니다.
  @@index([authDeviceId])
}

/// 기능 : 사용자별 activation 달성 여부와 달성 시점을 저장합니다.
model UserActivationSnapshot {
  /// 기능 : activation snapshot row의 고유 식별자입니다.
  id                      String               @id @default(uuid()) @db.Uuid
  /// 기능 : activation을 계산할 사용자입니다. 계정 실제 삭제 시 함께 삭제됩니다.
  userId                  String               @unique @db.Uuid
  /// 기능 : 현재 activation 계산 상태입니다.
  status                  UserActivationStatus @default(NOT_ACTIVATED)
  /// 기능 : 첫 딜 생성 이벤트 시각입니다.
  firstDealCreatedAt      DateTime?            @db.Timestamptz(3)
  /// 기능 : 첫 다음 행동/일정/회의록 연결 이벤트 시각입니다.
  firstMeaningfulActionAt DateTime?            @db.Timestamptz(3)
  /// 기능 : activation 달성 시각입니다.
  activatedAt             DateTime?            @db.Timestamptz(3)
  /// 기능 : activation 달성 이벤트 row의 사용자 timezone 기준 날짜입니다.
  activatedEventDate      DateTime?            @db.Date
  /// 기능 : activation 달성 이벤트 row에 저장된 사용자 timezone입니다.
  timeZone                String?
  /// 기능 : snapshot 마지막 계산 시각입니다.
  calculatedAt            DateTime             @default(now()) @db.Timestamptz(3)
  /// 기능 : row 생성 시각입니다.
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  /// 기능 : row 수정 시각입니다.
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)

  /// 기능 : activation snapshot을 소유한 사용자입니다.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 기능 : activation 상태와 cohort 날짜별 snapshot 조회에 사용합니다.
  @@index([status, activatedEventDate])
  /// 기능 : activation 달성 시각 기준 재계산 범위 조회에 사용합니다.
  @@index([activatedAt])
}

/// 기능 : 비식별 cohort 단위 retention 계산 결과를 저장합니다.
model RetentionCohortSnapshot {
  /// 기능 : retention cohort snapshot row의 고유 식별자입니다.
  id                String   @id @default(uuid()) @db.Uuid
  /// 기능 : cohort 기준 날짜입니다. 사용자 timezone 기준 activation date를 사용합니다.
  cohortDate        DateTime @db.Date
  /// 기능 : retention day offset입니다. 예: 1, 7, 30.
  dayOffset         Int
  /// 기능 : cohort에 포함된 사용자 수입니다.
  cohortUserCount   Int
  /// 기능 : 해당 day에 active로 관측된 사용자 수입니다.
  retainedUserCount Int
  /// 기능 : snapshot 계산 시각입니다.
  calculatedAt      DateTime @default(now()) @db.Timestamptz(3)
  /// 기능 : row 생성 시각입니다.
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  /// 기능 : row 수정 시각입니다.
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  /// 기능 : cohort 날짜와 retention day offset 중복 snapshot을 방지합니다.
  @@unique([cohortDate, dayOffset])
  /// 기능 : cohort 날짜 범위별 retention 조회에 사용합니다.
  @@index([cohortDate])
}

model Company {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  companyName     String
  companyFieldId  String    @db.Uuid
  companyRegionId String    @db.Uuid
  /// 기능 : 회사 상세 주소를 국가별 강제 검증 없이 자유 입력으로 저장한다.
  address         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime? @db.Timestamptz(3)
  deletedByUserId String?   @db.Uuid
  trashExpiresAt  DateTime? @db.Timestamptz(3)

  /// 기능 : 회사를 생성한 사용자다. 모든 회사 API는 이 userId로 소유권을 검증한다.
  user                 User                        @relation(fields: [userId], references: [id])
  /// 기능 : 회사 목록 필터에 사용되는 회사 분야다.
  companyField         CompanyField                @relation(fields: [companyFieldId], references: [id])
  /// 기능 : 회사 목록 필터에 사용되는 회사 지역이다.
  companyRegion        CompanyRegion               @relation(fields: [companyRegionId], references: [id])
  /// 기능 : 회사 특징에 대한 일반 메모 로그 목록이다.
  memoLogs             CompanyMemoLog[]
  /// 기능 : 작성자 본인만 복호화해 볼 수 있는 회사 개인 비밀 메모 로그 목록이다.
  privateMemoLogs      CompanyUserPrivateMemoLog[]
  /// 기능 : 회사에 소속된 담당자 목록이다.
  contacts             Contact[]
  /// 기능 : 회사가 연결된 딜 매핑 목록이다.
  dealCompanies        DealCompany[]
  meetingNoteCompanies MeetingNoteCompany[]
  meetingNoteContacts  MeetingNoteContact[]
  businessCardScanLogs BusinessCardScanLog[]

  @@index([userId, createdAt])
  @@index([userId, companyName])
  @@index([userId, companyFieldId])
  @@index([userId, companyRegionId])
  @@index([userId, deletedAt])
  @@index([userId, trashExpiresAt])
}

model Contact {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  companyId           String    @db.Uuid
  username            String
  mobile              String
  /// 기능 : 담당자 전화번호가 속한 KR/US 국가 코드를 저장한다.
  phoneCountryCode    String?
  /// 기능 : 국가별 표준 national number 숫자 문자열을 저장한다.
  phoneNationalNumber String?
  /// 기능 : 검색/중복/외부 연동 기준이 되는 E.164 전화번호를 저장한다.
  phoneE164           String?
  email               String
