/// 기능 : 딜 상세 활동 내역에 표시할 활동 정본이다. 비공개 메모와 외부 제공자 원문 세부 정보는 저장하지 않는다.
model DealActivity {
  /// 기능 : 딜 활동 행의 고유 식별자다.
  id                String                 @id @default(uuid()) @db.Uuid
  /// 기능 : 활동을 소유한 사용자다. 모든 활동 조회와 변경은 이 userId로 제한한다.
  userId            String                 @db.Uuid
  /// 기능 : 활동이 속한 딜 식별자다.
  dealId            String                 @db.Uuid
  /// 기능 : 활동 내역 표시 유형과 비즈니스 분기 기준이다.
  activityType      DealActivityType
  /// 기능 : 활동 생성 출처를 구분한다.
  sourceType        DealActivitySourceType
  /// 기능 : 원본 사건 또는 원본 레코드 ID다. 자동 활동의 중복 생성 방지 기준으로 사용한다.
  sourceId          String?                @db.Uuid
  /// 기능 : 활동 내역 제목이다. 구조화 로그에 원문을 남기지 않는다.
  title             String
  /// 기능 : 안전한 짧은 요약이다. 비공개 메모와 외부 제공자 원문 세부 정보는 넣지 않는다.
  summary           String?
  /// 기능 : 수동 활동 본문이다. 민감정보가 포함될 수 있으므로 로그와 목록 요약에 원문을 남기지 않는다.
  body              String?                @db.Text
  /// 기능 : 활동 발생 시각이다. 활동 내역 정렬 커서의 1차 기준이다.
  occurredAt        DateTime               @db.Timestamptz(3)
  /// 기능 : User Web 이동에 필요한 안전한 연결 레코드 배열만 저장한다.
  linkedRecordsJson Json?
  /// 기능 : 자동 활동 생성에 필요한 허용 목록 기반 비식별 메타데이터만 저장한다.
  metadataJson      Json?
  /// 기능 : 활동 행 생성 시각이다.
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  /// 기능 : 활동 행 수정 시각이다.
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)

  /// 기능 : 활동을 소유한 사용자다.
  user User @relation(fields: [userId], references: [id])
  /// 기능 : 활동이 속한 딜이다.
  deal Deal @relation(fields: [dealId], references: [id])

  /// 기능 : 딜 상세 활동 내역을 최신순 커서 페이지네이션으로 조회한다.
  @@index([userId, dealId, occurredAt(sort: Desc), id(sort: Desc)])
  /// 기능 : 사용자 단위 활동 유형 필터와 운영 확인에 사용한다.
  @@index([userId, activityType, occurredAt])
  /// 기능 : 자동 활동의 원본 레코드 추적과 중복 생성 방지 확인에 사용한다.
  @@index([userId, sourceType, sourceId])
}

