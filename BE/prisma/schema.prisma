generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OAuthProvider {
  /// 기능 : 기존 Kakao OAuth 계정 값을 보존하되 신규 런타임 로그인에서는 사용하지 않습니다.
  KAKAO
  /// 기능 : Google OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  GOOGLE
  /// 기능 : Apple OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  APPLE
  /// 기능 : LINE OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  LINE
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthDeviceStatus {
  ACTIVE
  REPLACED
  REVOKED
}

enum AuthDeviceSlot {
  MOBILE
  PERSONAL_LAPTOP
  WORK_LAPTOP
}

/// 기능 : 사용자 에러 신고 처리 상태를 구분합니다.
enum ErrorReportStatus {
  OPEN
}

/// 기능 : 사용자 지원 요청 문의 유형을 구분합니다.
enum SupportRequestType {
  FEATURE_QUESTION
  PRICING_QUESTION
  PHONE_CONSULTATION
  FEATURE_SUGGESTION
  OTHER
}

/// 기능 : 사용자 지원 요청 처리 상태를 구분합니다.
enum SupportRequestStatus {
  OPEN
}

/// 기능 : 로그인 전 공개 문의 접수 처리 상태를 구분합니다.
enum PublicContactRequestStatus {
  OPEN
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String?
  displayName          String?
  role                 UserRole   @default(USER)
  status               UserStatus @default(ACTIVE)
  timeZone             String     @default("Asia/Seoul")
  preferredLocale      String     @default("ko-KR")
  /// 기능 : 사용자의 기본 국가 코드이며 글로벌 입력값 기본값에 사용합니다.
  countryCode          String     @default("KR")
  /// 기능 : 사용자의 기본 통화 코드이며 금액 입력 기본값에 사용합니다.
  defaultCurrencyCode  String     @default("KRW")
  signupLocale         String?
  signupCountryCode    String?
  signupTimeZone       String?
  lastLoginLocale      String?
  lastLoginCountryCode String?
  lastLoginTimeZone    String?
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  oauthAccounts   UserOAuthAccount[]
  authDevices     AuthDevice[]
  authSessions    AuthSession[]
  /// 기능 : 사용자가 등록한 회사 목록이다.
  companies       Company[]
  /// 기능 : 사용자가 만든 회사 분야 옵션 목록이다.
  companyFields   CompanyField[]
  /// 기능 : 사용자가 만든 회사 지역 옵션 목록이다.
  companyRegions  CompanyRegion[]
  /// 기능 : 사용자가 접수한 에러 신고 목록입니다.
  errorReports    ErrorReport[]
  /// 기능 : 사용자가 접수한 지원 요청 목록입니다.
  supportRequests SupportRequest[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

/// 기능 : User Web 도움말 모달에서 접수된 에러 신고를 저장합니다.
model ErrorReport {
  id                        String            @id @default(uuid()) @db.Uuid
  userId                    String            @db.Uuid
  userEmail                 String?
  userDisplayName           String?
  userRole                  UserRole
  description               String
  pageUrl                   String
  userAgent                 String?
  requestId                 String?
  screenshotStorageProvider String?
  screenshotStorageBucket   String?
  screenshotStorageKey      String?
  screenshotFileName        String?
  screenshotMimeType        String?
  screenshotSizeBytes       Int?
  screenshotChecksum        String?
  status                    ErrorReportStatus @default(OPEN)
  createdAt                 DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime          @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// 기능 : User Web 도움말 모달에서 접수된 지원 요청을 저장합니다.
model SupportRequest {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  userEmail       String?
  userDisplayName String?
  userRole        UserRole
  type            SupportRequestType
  description     String
  pageUrl         String
  userAgent       String?
  requestId       String?
  status          SupportRequestStatus @default(OPEN)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
}

/// 기능 : 로그인 전 공개 문의 페이지에서 접수된 도입/상담 요청을 저장합니다.
model PublicContactRequest {
  id                          String                     @id @default(uuid()) @db.Uuid
  /// 기능 : 사용자가 공개 문의 form에 입력한 이메일을 저장합니다.
  email                       String
  /// 기능 : 회원 여부 확인과 검색에 사용할 trim/lower-case 이메일을 저장합니다.
  normalizedEmail             String
  /// 기능 : 사용자가 선택한 사용 인원 규모를 저장합니다.
  companySize                 String
  /// 기능 : 사용자가 입력한 이름을 저장합니다.
  firstName                   String
  /// 기능 : 사용자가 입력한 성을 저장합니다.
  lastName                    String
  /// 기능 : 사용자가 입력한 회사명을 저장합니다.
  companyName                 String
  /// 기능 : 사용자가 입력한 직함을 저장합니다.
  jobTitle                    String
  /// 기능 : 사용자가 선택한 국가 또는 지역 코드를 저장합니다.
  region                      String
  /// 기능 : 사용자가 입력한 연락처 전화번호를 저장합니다.
  phone                       String
  /// 기능 : 사용자가 입력한 OneHand 사용 계획을 저장합니다.
  plan                        String                     @db.Text
  /// 기능 : 사용자가 선택한 OneHand 인지 경로를 저장합니다.
  source                      String
  /// 기능 : 제품 소식과 온보딩 안내 수신 동의 여부를 저장합니다.
  marketingAgreement          Boolean                    @default(false)
  /// 기능 : 제출 시점에 같은 정규화 이메일을 가진 삭제되지 않은 회원이 있었는지 저장합니다.
  wasExistingUserAtSubmission Boolean                    @default(false)
  /// 기능 : 문의가 제출된 공개 페이지 URL을 저장합니다.
  pageUrl                     String?
  /// 기능 : 문의가 제출된 공개 사이트 언어를 저장합니다.
  locale                      String?
  /// 기능 : 문의 제출 요청의 user-agent를 저장합니다.
  userAgent                   String?
  /// 기능 : Backend request id를 저장합니다.
  requestId                   String?
  /// 기능 : 공개 문의 처리 상태를 저장합니다.
  status                      PublicContactRequestStatus @default(OPEN)
  createdAt                   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([normalizedEmail])
  @@index([wasExistingUserAtSubmission, createdAt])
}

model UserOAuthAccount {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  provider         OAuthProvider
  providerUserId   String
  providerEmail    String?
  accessTokenHash  String?
  refreshTokenHash String?
  tokenExpiresAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
}

model AuthDevice {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  deviceSlot   AuthDeviceSlot
  deviceIdHash String
  label        String?
  status       AuthDeviceStatus @default(ACTIVE)
  lastSeenAt   DateTime?
  replacedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  sessions AuthSession[]

  @@index([userId])
  @@index([userId, deviceSlot, status])
  @@index([userId, deviceIdHash])
}

model AuthSession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  authDeviceId     String            @db.Uuid
  status           AuthSessionStatus @default(ACTIVE)
  refreshTokenHash String?
  userAgent        String?
  ipAddressHash    String?
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  authDevice AuthDevice @relation(fields: [authDeviceId], references: [id])

  @@index([userId])
  @@index([authDeviceId])
  @@index([status])
  @@index([expiresAt])
}

model Company {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  companyName     String
  companyFieldId  String   @db.Uuid
  companyRegionId String   @db.Uuid
  /// 기능 : 회사 상세 주소를 국가별 강제 검증 없이 자유 입력으로 저장한다.
  address         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// 기능 : 회사를 생성한 사용자다. 모든 회사 API는 이 userId로 소유권을 검증한다.
  user          User          @relation(fields: [userId], references: [id])
  /// 기능 : 회사 목록 필터에 사용되는 회사 분야다.
  companyField  CompanyField  @relation(fields: [companyFieldId], references: [id])
  /// 기능 : 회사 목록 필터에 사용되는 회사 지역이다.
  companyRegion CompanyRegion @relation(fields: [companyRegionId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, companyName])
  @@index([userId, companyFieldId])
  @@index([userId, companyRegionId])
}

model CompanyField {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  field     String
  createdAt DateTime @default(now())

  /// 기능 : 회사 분야를 생성한 사용자다.
  user      User      @relation(fields: [userId], references: [id])
  /// 기능 : 이 분야를 사용하는 회사 목록이다. 하나라도 있으면 분야 삭제를 막는다.
  companies Company[]

  @@unique([userId, field])
  @@index([userId])
}

model CompanyRegion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  region      String
  /// 기능 : 회사 지역이 속한 KR/US 국가 코드를 저장하고 legacy custom 지역은 null을 허용한다.
  countryCode String?
  /// 기능 : KR 시/도 또는 US State 표준 code를 저장하고 매핑 실패 custom 지역은 null을 유지한다.
  regionCode  String?
  createdAt   DateTime @default(now())

  /// 기능 : 회사 지역을 생성한 사용자다.
  user      User      @relation(fields: [userId], references: [id])
  /// 기능 : 이 지역을 사용하는 회사 목록이다. 하나라도 있으면 지역 삭제를 막는다.
  companies Company[]

  @@unique([userId, region])
  @@index([userId])
  @@index([userId, countryCode, regionCode])
}
