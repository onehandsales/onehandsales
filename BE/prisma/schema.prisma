generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OAuthProvider {
  /// 기능 : 기존 Kakao OAuth 계정 값을 보존하되 신규 런타임 로그인에서는 사용하지 않습니다.
  KAKAO
  /// 기능 : Google OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  GOOGLE
  /// 기능 : Apple OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  APPLE
  /// 기능 : LINE OAuth 계정을 런타임 로그인 제공자로 사용합니다.
  LINE
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuthDeviceStatus {
  ACTIVE
  REPLACED
  REVOKED
}

enum AuthDeviceSlot {
  MOBILE
  PERSONAL_LAPTOP
  WORK_LAPTOP
}

enum AiSuggestionPriority {
  LOW
  MEDIUM
  HIGH
}

/// 기능 : 딜 활동 내역에 표시할 활동 종류를 정의한다.
enum DealActivityType {
  DEAL_CREATED
  STAGE_CHANGED
  NEXT_ACTION_CREATED
  NEXT_ACTION_COMPLETION_CHANGED
  CALL
  MEETING
  EMAIL
  VISIT
  NOTE
}

/// 기능 : 딜 활동이 시스템, 사용자, 연결 도메인 중 어디에서 생성됐는지 정의한다.
enum DealActivitySourceType {
  SYSTEM
  USER
  NEXT_ACTION
}

/// 기능 : 제품 분석 이벤트가 어떤 경로에서 기록됐는지 구분합니다.
enum ProductAnalyticsEventSource {
  CLIENT
  SERVER
  SYSTEM
}

/// 기능 : 사용자 activation snapshot 계산 상태를 구분합니다.
enum UserActivationStatus {
  NOT_ACTIVATED
  ACTIVATED
}

/// 기능 : 제품 분석 이벤트가 연결할 수 있는 안전한 대상 타입을 구분합니다.
enum ProductAnalyticsTargetType {
  USER
  DEAL
  EXPORT
}

/// 기능 : 사용자 에러 신고 처리 상태를 구분합니다.
enum ErrorReportStatus {
  OPEN
}

/// 기능 : 사용자 지원 요청 문의 유형을 구분합니다.
enum SupportRequestType {
  FEATURE_QUESTION
  PRICING_QUESTION
  PHONE_CONSULTATION
  FEATURE_SUGGESTION
  OTHER
}

/// 기능 : 사용자 지원 요청 처리 상태를 구분합니다.
enum SupportRequestStatus {
  OPEN
}

/// 기능 : 로그인 전 공개 문의 접수 처리 상태를 구분합니다.
enum PublicContactRequestStatus {
  OPEN
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String?
  displayName          String?
  role                 UserRole   @default(USER)
  status               UserStatus @default(ACTIVE)
  timeZone             String     @default("Asia/Seoul")
  preferredLocale      String     @default("ko-KR")
  /// 기능 : 사용자의 기본 국가 코드이며 글로벌 입력값 기본값에 사용합니다.
  countryCode          String     @default("KR")
  /// 기능 : 사용자의 기본 통화 코드이며 금액 입력 기본값에 사용합니다.
  defaultCurrencyCode  String     @default("KRW")
  signupLocale         String?
  signupCountryCode    String?
  signupTimeZone       String?
  lastLoginLocale      String?
  lastLoginCountryCode String?
  lastLoginTimeZone    String?
  lastLoginAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  oauthAccounts           UserOAuthAccount[]
  authDevices             AuthDevice[]
  authSessions            AuthSession[]
  /// 기능 : 사용자가 등록한 회사 목록이다.
  companies               Company[]
  /// 기능 : 사용자가 만든 회사 분야 옵션 목록이다.
  companyFields           CompanyField[]
  /// 기능 : 사용자가 만든 회사 지역 옵션 목록이다.
  companyRegions          CompanyRegion[]
  /// 기능 : 사용자가 작성한 회사 일반 메모 로그 목록이다.
  companyMemoLogs         CompanyMemoLog[]
  /// 기능 : 사용자가 작성한 회사 개인 비밀 메모 로그 목록이다.
  companyPrivateMemoLogs  CompanyUserPrivateMemoLog[]
  /// 기능 : 사용자가 등록한 담당자 목록이다.
  contacts                Contact[]
  /// 기능 : 사용자가 만든 담당자 직급 옵션 목록이다.
  contactJobGrades        ContactJobGrade[]
  /// 기능 : 사용자가 만든 담당자 부서 옵션 목록이다.
  contactDepartments      ContactDepartment[]
  /// 기능 : 사용자가 작성한 담당자 일반 메모 로그 목록이다.
  contactMemoLogs         ContactMemoLog[]
  /// 기능 : 사용자가 작성한 담당자 개인 비밀 메모 로그 목록이다.
  contactPrivateMemoLogs  ContactUserPrivateMemoLog[]
  /// 기능 : 사용자가 등록한 제품 목록이다.
  products                Product[]
  /// 기능 : 사용자가 만든 제품 카테고리 옵션 목록이다.
  productCategories       ProductCategory[]
  /// 기능 : 사용자가 만든 제품 상태 옵션 목록이다.
  productStatuses         ProductStatus[]
  /// 기능 : 사용자가 작성한 제품 일반 메모 로그 목록이다.
  productMemoLogs         ProductMemoLog[]
  /// 기능 : 사용자가 작성한 제품 개인 비밀 메모 로그 목록이다.
  productPrivateMemoLogs  ProductUserPrivateMemoLog[]
  /// 기능 : 사용자가 등록한 딜 목록이다.
  deals                   Deal[]
  /// 기능 : 사용자가 딜에 연결한 회사 매핑 목록이다.
  dealCompanies           DealCompany[]
  /// 기능 : 사용자가 딜에 연결한 담당자 매핑 목록이다.
  dealContacts            DealContact[]
  /// 기능 : 사용자가 작성한 딜 다음 행동 로그 목록이다.
  dealFollowingActionLogs DealFollowingActionLog[]
  /// 기능 : 사용자가 작성한 딜 메모 로그 목록이다.
  dealMemoLogs            DealMemoLog[]
  /// 기능 : 사용자가 만든 딜 활동 목록이다. 모든 조회와 변경은 이 userId로 제한한다.
  dealActivities          DealActivity[]
  /// 기능 : 사용자가 딜에 연결한 제품 매핑 목록이다.
  dealProducts            DealProduct[]
  /// 기능 : 사용자의 제품 분석 원본 이벤트 목록입니다. 계정 실제 삭제 시 함께 삭제됩니다.
  productAnalyticsEvents  ProductAnalyticsEvent[]
  /// 기능 : 사용자의 activation 계산 snapshot입니다. 계정 실제 삭제 시 함께 삭제됩니다.
  activationSnapshot      UserActivationSnapshot?
  /// 기능 : 사용자가 접수한 에러 신고 목록입니다.
  errorReports            ErrorReport[]
  /// 기능 : 사용자가 접수한 지원 요청 목록입니다.
  supportRequests         SupportRequest[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

/// 기능 : User Web 도움말 모달에서 접수된 에러 신고를 저장합니다.
model ErrorReport {
  id                        String            @id @default(uuid()) @db.Uuid
  userId                    String            @db.Uuid
  userEmail                 String?
  userDisplayName           String?
  userRole                  UserRole
  description               String
  pageUrl                   String
  userAgent                 String?
  requestId                 String?
  screenshotStorageProvider String?
  screenshotStorageBucket   String?
  screenshotStorageKey      String?
  screenshotFileName        String?
  screenshotMimeType        String?
  screenshotSizeBytes       Int?
  screenshotChecksum        String?
  status                    ErrorReportStatus @default(OPEN)
  createdAt                 DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime          @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// 기능 : User Web 도움말 모달에서 접수된 지원 요청을 저장합니다.
model SupportRequest {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  userEmail       String?
  userDisplayName String?
  userRole        UserRole
  type            SupportRequestType
  description     String
  pageUrl         String
  userAgent       String?
  requestId       String?
  status          SupportRequestStatus @default(OPEN)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
}

/// 기능 : 로그인 전 공개 문의 페이지에서 접수된 도입/상담 요청을 저장합니다.
model PublicContactRequest {
  id                          String                     @id @default(uuid()) @db.Uuid
  /// 기능 : 사용자가 공개 문의 form에 입력한 이메일을 저장합니다.
  email                       String
  /// 기능 : 회원 여부 확인과 검색에 사용할 trim/lower-case 이메일을 저장합니다.
  normalizedEmail             String
  /// 기능 : 사용자가 선택한 사용 인원 규모를 저장합니다.
  companySize                 String
  /// 기능 : 사용자가 입력한 이름을 저장합니다.
  firstName                   String
  /// 기능 : 사용자가 입력한 성을 저장합니다.
  lastName                    String
  /// 기능 : 사용자가 입력한 회사명을 저장합니다.
  companyName                 String
  /// 기능 : 사용자가 입력한 직함을 저장합니다.
  jobTitle                    String
  /// 기능 : 사용자가 선택한 국가 또는 지역 코드를 저장합니다.
  region                      String
  /// 기능 : 사용자가 입력한 연락처 전화번호를 저장합니다.
  phone                       String
  /// 기능 : 사용자가 입력한 OneHand 사용 계획을 저장합니다.
  plan                        String                     @db.Text
  /// 기능 : 사용자가 선택한 OneHand 인지 경로를 저장합니다.
  source                      String
  /// 기능 : 제품 소식과 온보딩 안내 수신 동의 여부를 저장합니다.
  marketingAgreement          Boolean                    @default(false)
  /// 기능 : 제출 시점에 같은 정규화 이메일을 가진 삭제되지 않은 회원이 있었는지 저장합니다.
  wasExistingUserAtSubmission Boolean                    @default(false)
  /// 기능 : 문의가 제출된 공개 페이지 URL을 저장합니다.
  pageUrl                     String?
  /// 기능 : 문의가 제출된 공개 사이트 언어를 저장합니다.
  locale                      String?
  /// 기능 : 문의 제출 요청의 user-agent를 저장합니다.
  userAgent                   String?
  /// 기능 : Backend request id를 저장합니다.
  requestId                   String?
  /// 기능 : 공개 문의 처리 상태를 저장합니다.
  status                      PublicContactRequestStatus @default(OPEN)
  createdAt                   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([normalizedEmail])
  @@index([wasExistingUserAtSubmission, createdAt])
}

model UserOAuthAccount {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  provider         OAuthProvider
  providerUserId   String
  providerEmail    String?
  accessTokenHash  String?
  refreshTokenHash String?
  tokenExpiresAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
}

model AuthDevice {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  deviceSlot   AuthDeviceSlot
  deviceIdHash String
  label        String?
  status       AuthDeviceStatus @default(ACTIVE)
  lastSeenAt   DateTime?
  replacedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user                   User                    @relation(fields: [userId], references: [id])
  sessions               AuthSession[]
  /// 기능 : 이 인증 기기에서 발생한 제품 분석 이벤트 목록입니다.
  productAnalyticsEvents ProductAnalyticsEvent[]

  @@index([userId])
  @@index([userId, deviceSlot, status])
  @@index([userId, deviceIdHash])
}

model AuthSession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  authDeviceId     String            @db.Uuid
  status           AuthSessionStatus @default(ACTIVE)
  refreshTokenHash String?
  userAgent        String?
  ipAddressHash    String?
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user                   User                    @relation(fields: [userId], references: [id])
  authDevice             AuthDevice              @relation(fields: [authDeviceId], references: [id])
  /// 기능 : 이 app session에서 발생한 제품 분석 이벤트 목록입니다.
  productAnalyticsEvents ProductAnalyticsEvent[]

  @@index([userId])
  @@index([authDeviceId])
  @@index([status])
  @@index([expiresAt])
}

/// 기능 : Global B2C 제품 사용 분석을 위한 allowlist 기반 원본 이벤트입니다.
model ProductAnalyticsEvent {
  /// 기능 : 분석 이벤트 row의 고유 식별자입니다.
  id             String                      @id @default(uuid()) @db.Uuid
  /// 기능 : 이벤트를 발생시킨 사용자입니다. 계정 실제 삭제 시 함께 삭제됩니다.
  userId         String                      @db.Uuid
  /// 기능 : Backend app session 식별자입니다. Client가 보내지 않고 Backend가 현재 인증에서 채웁니다.
  authSessionId  String?                     @db.Uuid
  /// 기능 : 인증 device 식별자입니다. AuthSession 조회로 Backend가 채웁니다.
  authDeviceId   String?                     @db.Uuid
  /// 기능 : allowlist에 등록된 snake_case 이벤트 이름입니다.
  eventName      String
  /// 기능 : 이벤트 payload schema 버전입니다.
  eventVersion   Int                         @default(1)
  /// 기능 : client, server, system 중 이벤트 기록 출처입니다.
  source         ProductAnalyticsEventSource
  /// 기능 : 이벤트 발생 시각입니다. UTC instant로 저장합니다.
  occurredAt     DateTime                    @db.Timestamptz(3)
  /// 기능 : 이벤트 당시 사용자 timezone 기준 날짜입니다. D1/D7/D30 계산에 사용합니다.
  eventDate      DateTime                    @db.Date
  /// 기능 : 이벤트 당시 사용자 IANA timezone입니다.
  timeZone       String
  /// 기능 : 같은 server event의 중복 기록을 막는 선택 idempotency key입니다.
  idempotencyKey String?
  /// 기능 : 이벤트가 연결된 안전한 대상 타입입니다. 회사명/담당자명 같은 PII는 저장하지 않습니다.
  targetType     ProductAnalyticsTargetType?
  /// 기능 : 이벤트가 연결된 안전한 대상 UUID입니다. payload에는 중복 저장하지 않습니다.
  targetId       String?                     @db.Uuid
  /// 기능 : event별 allowlist schema를 통과한 비식별 payload입니다.
  payloadJson    Json                        @default("{}")
  /// 기능 : 이벤트가 수집된 시각입니다.
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)

  /// 기능 : 이벤트를 발생시킨 사용자입니다.
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 기능 : 이벤트가 발생한 app session입니다.
  authSession AuthSession? @relation(fields: [authSessionId], references: [id], onDelete: SetNull)
  /// 기능 : 이벤트가 발생한 인증 기기입니다.
  authDevice  AuthDevice?  @relation(fields: [authDeviceId], references: [id], onDelete: SetNull)

  /// 기능 : server event idempotency key 중복 저장을 방지합니다.
  @@unique([userId, eventName, idempotencyKey])
  /// 기능 : 사용자별 핵심 event 발생 순서와 activation 계산 조회에 사용합니다.
  @@index([userId, eventName, occurredAt])
  /// 기능 : 사용자 timezone 기준 일자별 active 여부 계산에 사용합니다.
  @@index([userId, eventDate])
  /// 기능 : event 이름과 사용자 timezone 기준 날짜별 aggregate 계산에 사용합니다.
  @@index([eventName, eventDate])
  /// 기능 : client/server/system 출처별 수집 상태 확인에 사용합니다.
  @@index([source, createdAt])
  /// 기능 : 365일 raw event retention purge에 사용합니다.
  @@index([occurredAt])
  /// 기능 : 현재 app session에서 파생된 event 추적에 사용합니다.
  @@index([authSessionId])
  /// 기능 : 인증 device 단위 event 분석에 사용합니다.
  @@index([authDeviceId])
}

/// 기능 : 사용자별 activation 달성 여부와 달성 시점을 저장합니다.
model UserActivationSnapshot {
  /// 기능 : activation snapshot row의 고유 식별자입니다.
  id                      String               @id @default(uuid()) @db.Uuid
  /// 기능 : activation을 계산할 사용자입니다. 계정 실제 삭제 시 함께 삭제됩니다.
  userId                  String               @unique @db.Uuid
  /// 기능 : 현재 activation 계산 상태입니다.
  status                  UserActivationStatus @default(NOT_ACTIVATED)
  /// 기능 : 첫 딜 생성 이벤트 시각입니다.
  firstDealCreatedAt      DateTime?            @db.Timestamptz(3)
  /// 기능 : 첫 다음 행동/일정/회의록 연결 이벤트 시각입니다.
  firstMeaningfulActionAt DateTime?            @db.Timestamptz(3)
  /// 기능 : activation 달성 시각입니다.
  activatedAt             DateTime?            @db.Timestamptz(3)
  /// 기능 : activation 달성 이벤트 row의 사용자 timezone 기준 날짜입니다.
  activatedEventDate      DateTime?            @db.Date
  /// 기능 : activation 달성 이벤트 row에 저장된 사용자 timezone입니다.
  timeZone                String?
  /// 기능 : snapshot 마지막 계산 시각입니다.
  calculatedAt            DateTime             @default(now()) @db.Timestamptz(3)
  /// 기능 : row 생성 시각입니다.
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  /// 기능 : row 수정 시각입니다.
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)

  /// 기능 : activation snapshot을 소유한 사용자입니다.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 기능 : activation 상태와 cohort 날짜별 snapshot 조회에 사용합니다.
  @@index([status, activatedEventDate])
  /// 기능 : activation 달성 시각 기준 재계산 범위 조회에 사용합니다.
